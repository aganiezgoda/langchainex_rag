# =============================================================================
# Azure OpenAI Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to source control!
# =============================================================================

# Azure OpenAI endpoint URL
# Format: https://<your-resource-name>.openai.azure.com/
# Find this in: Azure Portal > Your OpenAI resource > Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# API version for Azure OpenAI
# Recommended: Use a recent stable version
# See: https://learn.microsoft.com/azure/ai-services/openai/reference#api-specs
OPENAI_API_VERSION=2024-08-01-preview

# Embedding model deployment name
# This is the NAME you gave the deployment, not the model name
# Common model: text-embedding-ada-002
# Find this in: Azure Portal > Your OpenAI resource > Model deployments
AZURE_DEPLOYMENT_EMBED=text-embedding-ada-002

# Chat/LLM model deployment name
# This is the NAME you gave the deployment, not the model name
# Common models: gpt-4, gpt-4o, gpt-35-turbo
# Find this in: Azure Portal > Your OpenAI resource > Model deployments
AZURE_DEPLOYMENT_LLM=gpt-4

# =============================================================================
# Optional: If NOT using DefaultAzureCredential (not recommended)
# =============================================================================
# Uncomment and set these ONLY if you can't use Azure AD authentication:
#
# AZURE_OPENAI_API_KEY=your-api-key-here
#
# Note: The tutorial uses DefaultAzureCredential which supports:
#   - Azure CLI login (az login) - recommended for development
#   - Managed Identity - recommended for production
#   - Visual Studio Code authentication
#   - Environment variables (AZURE_CLIENT_ID, AZURE_TENANT_ID, AZURE_CLIENT_SECRET)
